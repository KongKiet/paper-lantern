# Copy to .env. Also used as `docker run --env-file .env`, so keep every line a
# literal KEY=value: no quotes around values, no ${VAR} interpolation, no inline comments.
# GEMINI_API_KEY takes precedence; API_KEY is the fallback when it is unset or empty.
GEMINI_API_KEY=
API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FILE_SEARCH_STORE=
SUPPORT_BASE_URL=https://support.optisigns.com
GEMINI_QUERY_TIMEOUT_SECONDS=120
SUPPORT_ARTICLE_LIMIT=30
